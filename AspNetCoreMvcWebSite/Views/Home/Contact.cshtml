@{
    ViewData["Title"] = "Contact";
}

<div class="parallax">
    <section class="contact-page">
        @* Same heading as the Home page but without the outline (class no-stroke) *@
        <h1 class="main-heading no-stroke">Contact &amp; About</h1>

        @* Bootstrap grid: three columns from 768px up, stacked on tablets and phones *@
        <div class="row g-4 contact-row">
            <div class="col-12 col-md-4">
                <div class="contact-box">
                    <h2>Contact Us</h2>
                    <p>
                        This website is developed by u3309321.<br />
                        To get in contact please email <a href="mailto:u3309321@@uni.canberra.edu.au">u3309321@@uni.canberra.edu.au</a>
                    </p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="contact-box">
                    <h2>About Us</h2>
                    <p>
                        ArtAI is an introduction to artificial intelligence in the creative arts: AI art,
                        music and writing tools. It was created for an assignment on Web Design and Programming at the University of Canberra.<br />
                        This site is built on the ASP.NET Core framework and employs Bootstrap responsive
                        design techniques.
                    </p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="contact-box">
                    <h2>Copyright</h2>
                    <p>
                        All photos on this site were downloaded from <a href="https://unsplash.com/" target="_blank" rel="noopener">Unsplash</a>.<br />
                        The background image is by <a href="https://unsplash.com/@@joshuaworoniecki" target="_blank" rel="noopener">Joshua Woroniecki</a> (<a href="https://unsplash.com/photos/blue-sky-with-stars-during-night-time-TspYRqQrErc" target="_blank" rel="noopener">photo</a>).<br />
                        The six tile images are based on a photo by <a href="https://unsplash.com/@@stenuitj" target="_blank" rel="noopener">J&eacute;r&eacute;my Stenuit</a> (<a href="https://unsplash.com/photos/a-night-sky-with-stars-and-clouds-1gs9CO-AgUY" target="_blank" rel="noopener">photo</a>). I edited it in Canva to add the text and circles.<br />
                        The default image (default.jpg) is based on a photo by <a href="https://unsplash.com/@@ashleywhitlatch" target="_blank" rel="noopener">Ashley Whitlatch</a> (<a href="https://unsplash.com/photos/crescent-moon-in-gradient-sky-36aGnv29Ss0" target="_blank" rel="noopener">photo</a>). I edited it in Canva to add the text and frame.<br />
                        The icons in the footer are from <a href="https://fontawesome.com/" target="_blank" rel="noopener">Font Awesome</a>.<br />
                        The Anton, Montserrat, Lato, Niconne and Oxygen fonts are from <a href="https://fonts.google.com/" target="_blank" rel="noopener">Google Fonts</a>.<br />
                        The layout uses <a href="https://getbootstrap.com/" target="_blank" rel="noopener">Bootstrap 5</a>.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>