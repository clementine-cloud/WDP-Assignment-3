@model AIImage
@{
    ViewData["Title"] = "Delete AI Image";
}

<div class="parallax">
    <h1 class="page-title">Delete AI Image</h1>

    <div class="delete-box">
        <h2 class="delete-question">Are you sure you want to delete this?</h2>
        <h3 class="delete-subtitle">AIImage</h3>
        <hr />
        <dl class="detail-list">
            <dt>@Html.DisplayNameFor(m => m.Prompt)</dt>
            <dd>@Model.Prompt</dd>
            <dt>@Html.DisplayNameFor(m => m.ImageGenerator)</dt>
            <dd>@Model.ImageGenerator</dd>
            <dt>@Html.DisplayNameFor(m => m.UploadDate)</dt>
            <dd>@Model.UploadDate.ToString("dd/MM/yyyy hh:mm tt")</dd>
            <dt>@Html.DisplayNameFor(m => m.Filename)</dt>
            <dd>@Model.Filename</dd>
            <dt>@Html.DisplayNameFor(m => m.Like)</dt>
            <dd>@Model.Like</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            <span class="delete-separator">|</span>
            <a asp-action="Index">Back to List</a>
        </form>
    </div>
</div>
