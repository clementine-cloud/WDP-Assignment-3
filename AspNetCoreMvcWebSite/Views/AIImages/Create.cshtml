@model AIImage
@{
    ViewData["Title"] = "Upload AI Image";
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<div class="parallax">
    <h1 class="page-title">Upload AI Image</h1>

    @* enctype="multipart/form-data" is required, otherwise the browser does not send the picture file *@
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="ai-form-grid">
        <div class="ai-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Prompt" class="form-label"></label>
                <textarea asp-for="Prompt" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Prompt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageGenerator" class="form-label"></label>
                <input asp-for="ImageGenerator" class="form-control" />
                <span asp-validation-for="ImageGenerator" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UploadDate" class="form-label"></label>
                <input asp-for="UploadDate" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Like" class="form-label"></label>
                <input asp-for="Like" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label for="imageFile" class="form-label">Upload image file</label>
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" />
                <span asp-validation-for="Filename" class="text-danger"></span>
                @Html.ValidationMessage("imageFile", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary btn-sm">Create</button>
            </div>
        </div>

        @* Preview: shows the default picture until a file is chosen (site.js swaps it) *@
        <div class="ai-preview">
            <img id="imagePreview" src="@Url.Content(Model.ImageUrl)" alt="Preview of the chosen image" />
        </div>

        <div class="back-link">
            <a asp-action="Index">Back to List</a>
        </div>
    </form>
</div>
